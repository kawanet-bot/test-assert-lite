{
  "name": "test-assert-lite",
  "description": "Run your node:test and node:assert test files in browsers, as they are",
  "version": "0.0.1",
  "author": "Kawanet",
  "bin": {
    "test-assert": "./bin/cli.mjs"
  },
  "bugs": {
    "url": "https://github.com/kawanet/test-assert-lite/issues"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.13.3",
    "rollup": "^4.63.1",
    "simple-git-hooks": "^2.14.0",
    "ts-refine": "^0.6.3",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./types/test-assert-lite.d.ts",
      "module-sync": "./dist/test-assert-lite.js",
      "import": "./dist/test-assert-lite.js"
    },
    "./extras": {
      "types": "./types/extras.d.ts",
      "module-sync": "./dist/test-assert-lite.extras.js",
      "import": "./dist/test-assert-lite.extras.js"
    },
    "./test": {
      "types": "./exports/test.d.ts",
      "module-sync": "./exports/test.js",
      "import": "./exports/test.js"
    },
    "./assert": {
      "types": "./exports/assert.d.ts",
      "module-sync": "./exports/assert.js",
      "import": "./exports/assert.js"
    },
    "./assert/strict": {
      "types": "./exports/assert/strict.d.ts",
      "module-sync": "./exports/assert/strict.js",
      "import": "./exports/assert/strict.js"
    },
    "./reporter/html": {
      "types": "./exports/reporter/html.d.ts",
      "module-sync": "./exports/reporter/html.js",
      "import": "./exports/reporter/html.js"
    },
    "./reporter/spec": {
      "types": "./exports/reporter/spec.d.ts",
      "module-sync": "./exports/reporter/spec.js",
      "import": "./exports/reporter/spec.js"
    },
    "./reporter/tap": {
      "types": "./exports/reporter/tap.d.ts",
      "module-sync": "./exports/reporter/tap.js",
      "import": "./exports/reporter/tap.js"
    }
  },
  "files": [
    "bin/cli.mjs",
    "browser/run.html",
    "browser/session/",
    "dist/test-assert-lite.extras.js",
    "dist/test-assert-lite.js",
    "dist/test-assert-lite.min.js",
    "exports/",
    "htdocs/",
    "LICENSE",
    "README.md",
    "types/*.d.ts"
  ],
  "homepage": "https://github.com/kawanet/test-assert-lite#readme",
  "keywords": [
    "assert",
    "browser",
    "chai",
    "jest",
    "mocha",
    "node:assert",
    "node:test",
    "test",
    "vitest"
  ],
  "license": "MIT",
  "main": "./dist/test-assert-lite.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/test-assert-lite.git"
  },
  "scripts": {
    "build": "make -C builder",
    "fixpack": "fixpack",
    "git:pre-push": "make -C builder test-quick",
    "git:prepare-hooks": "[ -e .git ] && ./node_modules/.bin/simple-git-hooks",
    "prepack": "make -C builder is-buildable",
    "prepare": "make -C builder is-not-buildable 2> /dev/null || make -C builder clean all test",
    "test": "make -C builder test",
    "test-max": "make -C builder clean all test && make -C builder/pack pack test-dist && make -C browser test-playwright",
    "ts-refine": "./node_modules/.bin/ts-refine format && ./node_modules/.bin/ts-refine imports",
    "update-test-title": "find src -type f -name '*.test.ts' -exec perl -i -pe 's#(?<=^const TITLE = \").*?(?=\")#($ARGV =~ s:^src/::r)#em' {} +"
  },
  "sideEffects": false,
  "simple-git-hooks": {
    "pre-push": "npm run git:pre-push"
  },
  "type": "module",
  "types": "./types/test-assert-lite.d.ts"
}
